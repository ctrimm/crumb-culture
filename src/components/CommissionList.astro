---
import { commissions, bakes, url } from "../data/site";

// Link a stockist row to its bake page when a bake shares the name.
const slugFor = (name: string) => bakes.find((p) => p.title === name)?.slug;
---

<section class="commissions reveal" aria-label="Find our bread">
  <h2 class="section-label">Find our bread</h2>
  <ul class="commission-list">
    {
      commissions.map((c) => (
        <li class="commission-row">
          <span class="commission-year">{c.year}</span>
          {slugFor(c.name) ? (
            <a class="commission-name" href={url(`/${slugFor(c.name)}`)}>
              {c.name}
            </a>
          ) : (
            <span class="commission-name">{c.name}</span>
          )}
          <span class="commission-location">{c.location}</span>
        </li>
      ))
    }
  </ul>
</section>
