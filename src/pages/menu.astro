---
import Base from "../layouts/Base.astro";
import { site, bakes, imgSrcset, url } from "../data/site";

const categories = [...new Set(bakes.map((b) => b.category))];
---

<Base title={`MENU — ${site.name.toUpperCase()}`} current="menu">
  <section class="page-head">
    <p class="page-eyebrow">The menu</p>
    <h1>Baked this morning</h1>
    <p class="page-intro">
      Six staples, baked in small batches through the morning. Prices include
      the paper bag and the smell, which is free and considerable.
    </p>
  </section>

  {
    categories.map((cat) => (
      <section class="menu-group" aria-label={cat}>
        <h2 class="section-label">{cat}</h2>
        <div class="bake-grid">
          {bakes
            .filter((b) => b.category === cat)
            .map((b) => (
              <article class="bake-card reveal">
                <a href={url(`/${b.slug}`)} aria-label={`View bake: ${b.title}`}>
                  <img
                    src={url(b.image)}
                    alt={b.imageAlt}
                    width="752"
                    height="752"
                    loading="lazy"
                    srcset={imgSrcset(b.image, [480, 960], 752)}
                    sizes="(max-width: 760px) 92vw, 44vw"
                  />
                </a>
                <div class="bake-card-head">
                  <h3>{b.title}</h3>
                  <span class="feature-price">{b.price}</span>
                </div>
                <p class="bake-days">{b.bakeDays}</p>
                <p>{b.summary}</p>
                <a class="text-link" href={url(`/${b.slug}`)}>
                  About this bake: {b.title}
                </a>
              </article>
            ))}
        </div>
      </section>
    ))
  }

  <section class="menu-group reveal" aria-label="Bake schedule">
    <h2 class="section-label">Bake schedule</h2>
    <ul class="schedule-list">
      {
        bakes.map((b) => (
          <li class="schedule-row">
            <span class="bake-name">{b.title}</span>
            <span class="bake-when">{b.bakeDays}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="service-detail-list" aria-label="More from the bakehouse">
    <h2 class="section-label">More from the bakehouse</h2>
    {
      site.services.map((s, i) => (
        <article class="service-detail reveal">
          <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2>{s.title}</h2>
            <p>{s.summary}</p>
            <ul class="chip-list">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </section>
</Base>
