---
import Base from "../layouts/Base.astro";
import CommissionList from "../components/CommissionList.astro";
import { site, bakes, imgSrcset, url } from "../data/site";

const home = site.home;
---

<Base title={`${site.name.toUpperCase()}`} current="home">
  <!-- Hero: the signature split, with the cream card on the seam -->
  <section class="hero">
    <p class="hero-eyebrow">{home.eyebrow}</p>
    <div class="hero-split">
      <figure>
        <img
          src={url(home.heroLeft)}
          alt={home.heroLeftAlt}
          width="1120"
          height="1120"
          fetchpriority="high"
          srcset={imgSrcset(home.heroLeft, [480, 960], 1120)}
          sizes="(max-width: 760px) 46vw, 44vw"
        />
      </figure>
      <figure>
        <img
          src={url(home.heroRight)}
          alt={home.heroRightAlt}
          width="1120"
          height="1120"
          fetchpriority="high"
          srcset={imgSrcset(home.heroRight, [480, 960], 1120)}
          sizes="(max-width: 760px) 46vw, 44vw"
        />
      </figure>
      <div class="hero-card">
        <h1>{home.cardTitle}</h1>
        <p>{home.cardText}</p>
        <a class="pill-link" href={url(home.cardCtaHref)}>{home.cardCtaLabel}</a>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="manifesto reveal" aria-label="Bakehouse philosophy">
    {home.manifesto.map((p) => <p>{p}</p>)}
    <dl class="stats">
      {
        home.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Services index -->
  <section class="services-index reveal" aria-label="What the bakehouse does">
    <h2 class="section-label">What the bakehouse does</h2>
    <ul class="service-rows">
      {
        site.services.map((s, i) => (
          <li>
            <a href={url("/menu")}>
              <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="service-name">{s.title}</span>
              <span class="service-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Featured bakes -->
  <section class="featured" aria-label="Featured bakes">
    <h2 class="section-label">From the menu</h2>
    {
      bakes.slice(0, 4).map((p, i) => (
        <article class={`feature-row reveal ${i % 2 ? "flip" : ""}`}>
          <a href={url(`/${p.slug}`)} aria-label={`View bake: ${p.title}`}>
            <img
              src={url(p.image)}
              alt={p.imageAlt}
              width="752"
              height="752"
              loading="lazy"
              srcset={imgSrcset(p.image, [480, 960], 752)}
              sizes="(max-width: 760px) 92vw, 44vw"
            />
          </a>
          <div class="feature-meta">
            <p class="feature-kicker">
              {p.category} — {p.bakeDays}
            </p>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <p class="feature-price">{p.price}</p>
            <a class="text-link" href={url(`/${p.slug}`)}>
              About this bake: {p.title}
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- A bake day, hour by hour -->
  <section class="band reveal" aria-label="A bake day">
    <h2 class="section-label">A bake day, hour by hour</h2>
    <div class="process-grid">
      {
        site.process.map((p) => (
          <div class="process-step">
            <span class="process-num">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CommissionList />

  <!-- Closing CTA -->
  <section class="closing reveal">
    <p class="closing-line">Still warm, if you hurry.</p>
    <a class="pill-link" href={url("/visit")}>Plan your visit</a>
  </section>
</Base>
